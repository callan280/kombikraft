static const char*bc_program_12_vs="#version 100\nprecision highp float;\n\nattribute vec2 a_TextureCoordinate;\nattribute vec3 a_Position;\n\nuniform mat4 u_MVPMatrix;\nuniform float consumption_value,eco,comfort,sport,bar_pos,is_factory;\n\nvarying mediump vec2 varCoord;\nvarying mediump vec3 mixed_co;\nvarying mediump float birth;\n\n#define DEFAULT vec3(.3,.3,.3)\n#define ECO vec3(0.,.45,.9) // edrive = eco\n#define COMFORT vec3(.59,.68,.70)\n#define SPORT vec3(1.,0.29,0.)\n#define FACTORY vec3(1.,1.,1.) * 0.8\n\nvoid main(void) {\n\n\t// -- mix color\n\tmediump float is_default = 1.-clamp(eco + comfort + sport + is_factory, 0., 1.);\n\tmixed_co = (DEFAULT * is_default) + (ECO * eco) + (COMFORT * comfort) + ((SPORT + 0.1) * sport);\n\t\tmixed_co = mix(mixed_co, FACTORY, is_factory);\n\n\tvarCoord = a_TextureCoordinate;\n\n\tvec3 p = a_Position;\n\t\t//mediump float little_step = step(1.1,bar_pos); //222 79\n\t\t//p.x += (clamp(bar_pos,0.,1.) * 222.) + (little_step * (bar_pos - 1.) * 79.);\t\n\tgl_Position = u_MVPMatrix * vec4(p, 1.);\n\n\t// -- FS handovers\n\tbirth = smoothstep(0.2, 0.,consumption_value);\n}";
static const char*bc_program_12_fs="#version 100\n\nprecision mediump float;\n\nuniform sampler2D tex0;\nuniform float opacity;\n\nvarying mediump vec2 varCoord;\nvarying mediump vec3 mixed_co;\nvarying float birth;\n\nvoid main(void) {\n\n\tvec4 smpl = texture2D(tex0,varCoord);\n\tfloat alphamask = birth * pow(smpl.b, 3.);// mix(smpl.r * fade, smpl.b, birth);\n\tfloat hl = smpl.g * 0.5;\n\n\tvec4 shd = vec4((mixed_co * smpl.r) + hl, alphamask);\n\t\n\tgl_FragColor = shd;\n\tgl_FragColor.a *= opacity;\n\n\t//gl_FragColor = smpl;\n}";
static const char*bc_program_13_vs="#version 100\nprecision highp float;\n\nattribute vec2 a_TextureCoordinate;\nattribute vec3 a_Position;\nuniform mat4 u_MVPMatrix;\nuniform float bar_pos,eco,comfort,sport,is_factory,consumption_value;\nvarying vec3 mixed_co;\nvarying vec2 uv;\nvarying mediump float pre_alpha;\n\n#define DEFAULT vec3(1.,1.,1.)\n#define ECO vec3(0.,.45,.9) // edrive = eco\n#define COMFORT vec3(.59,.68,.70)\n#define SPORT vec3(1.,0.29,0.)\n#define FACTORY vec3(1.,1.,1.)\n\nvoid main(void) {\n\n\tuv = a_TextureCoordinate;\n\n\t// -- FS handovers\n\tpre_alpha = (uv.y -  mix(0., 0.8, 1.-consumption_value)) * 0.15;\n\n\t// -- growth\n\tuv.y -= mix(0.,0.1, 1.-consumption_value);\n\n\t// -- color mixin\n\tmediump float is_default = 1.- clamp(eco + comfort + sport + is_factory, 0., 1.);\n\tmixed_co = (DEFAULT * is_default) + (ECO * eco) + (COMFORT * comfort) + ((SPORT + 0.1) * sport);\n\t\tmixed_co = mix(mixed_co, FACTORY, is_factory);\n\tmixed_co = mix(mixed_co, vec3(1.,1.,1.), is_factory);\n\tfloat satur = 0.8;\n\tmixed_co = mix(vec3(0.5,0.5,0.5), mixed_co, satur);\n\n\n\n\n\tvec3 p = a_Position;\n\t\t//mediump float little_step = step(1.1, bar_pos); //222 79\n\t\t//p.x += (clamp(bar_pos, 0., 1.) * 222.) + (little_step * (bar_pos - 1.) * 79.);\t\n\tgl_Position = u_MVPMatrix * vec4(p, 1.);\n}";
static const char*bc_program_13_fs="#version 100\n\nprecision mediump float;\n\nuniform sampler2D tex0;\nuniform float opacity,highlight;\nvarying vec3 mixed_co;\nvarying vec2 uv;\nvarying float pre_alpha;\n\nvoid main(void) {\n\n\tvec4 smpl = texture2D(tex0,uv);\n\tfloat alphamask = smpl.b * pre_alpha;\n\talphamask += highlight * smpl.r * 0.2;\n\n\tvec4 shd = vec4(mixed_co, alphamask);\n\tgl_FragColor = shd;\t\n\tgl_FragColor.a *= opacity;\n}";
static const char*bc_program_14_vs="#version 100\nprecision highp float;\n\nattribute vec4 a_Color;\nattribute vec2 a_TextureCoordinate;\nattribute vec3 a_Position;\n\nuniform mat4 u_MVPMatrix;\nuniform float consumption_value,eco,comfort,sport,bar_pos,is_factory;\n\nvarying mediump vec2 varCoord,paintCoord;\nvarying mediump vec3 mixed_co,mixed_hl,pack_look;\nvarying mediump float pre_alpha,v_consumption_value,bump;\n\n\n#define DEFAULT vec3(1.,1.,1.) * 0.6\n#define ECO vec3(0.,.5, 1.) // edrive = eco\n#define COMFORT vec3(.57,.68,.7) * 0.8\n#define SPORT vec3(1.,0.29,0.)\n#define FACTORY vec3(1.,1.,1.)\n\n#define HL_DEFAULT vec3(.7,.7,.7) * 0.6\n#define HL_ECO vec3(.3,.6,0.8)\n#define HL_COMFORT vec3(.65,.69,.7) * 0.9\n#define HL_SPORT vec3(1.,0.5,0.2)\n#define HL_FACTORY vec3(1.,1.,1.)\n\n\nvoid main(void){\n\n\t// -- texture coordinates\n\tvarCoord = a_TextureCoordinate;\n\t\t// -- growth\n\t\tvarCoord.y += mix(0.965,0.007,consumption_value);\n\n\tpaintCoord = a_TextureCoordinate;\n\t\tpaintCoord.y -= smoothstep(-3.,10.,consumption_value);\n\n\t// -- mix color\n\tfloat is_default = 1. - clamp(eco + comfort + sport + is_factory, 0., 1.);\n\tmixed_co = (DEFAULT * is_default) + (ECO * eco) + (COMFORT * comfort) + ((SPORT + 0.1) * sport);\n\tmixed_hl = (HL_DEFAULT * is_default) + (HL_ECO * eco) + (HL_COMFORT * comfort) + (HL_SPORT * sport);\n\t//mixed_hl = mix(mixed_co, vec3(1.,1.,1.), 0.2);\n\n\t#ifdef IS_FACTORY\n\t\tmixed_co = mix(mixed_co, FACTORY, is_factory);\n\t\tmixed_hl = mix(mixed_co, HL_FACTORY, is_factory);\n\t#endif\n\t\t\n\n\t// -- bar pos\n\t//vec3 p = a_Position;\n\t//\tfloat little_step = step(1.1, bar_pos); //222 79\n\t//\tp.x += (clamp(bar_pos, 0., 1.) * 222.) + (little_step * (bar_pos - 1.) * 79.);\t\n\tgl_Position = u_MVPMatrix * vec4(a_Position, 1.);\n\n\n\t// -- FS handovers\n\tpre_alpha = 1.;\n\tpre_alpha *= a_Color.b; // antialiasing\n\t\n\tv_consumption_value = consumption_value;\n\tbump = a_TextureCoordinate.y;\n\n\n\t// -- pack em\n\tfloat fade = a_TextureCoordinate.t * mix(4.,1.,consumption_value); // top top bottom\n\tfade += 0.19;\n\tfloat lightbow_fade = (1.-a_TextureCoordinate.t) * 3. - mix(2.5, 1., consumption_value);  // bottom to top\n\tfloat lightfake_end = 1.-consumption_value;\n\tpack_look = vec3(fade, lightbow_fade, lightfake_end);\n}";
static const char*bc_program_14_fs="#version 100\nprecision mediump float;\n\nuniform sampler2D tex0,tex1;\nuniform float opacity;\nvarying mediump vec2 varCoord,paintCoord;\nvarying mediump vec3 mixed_co,mixed_hl,pack_look;\nvarying float pre_alpha,v_consumption_value,bump;\n\nvoid main(void){\n\n\n\t// -- samples\n\tvec4 smpl = texture2D(tex0, varCoord);\n\tvec4 smpl_paint = texture2D(tex1, paintCoord);\n\n\n\t\t// -- toolbox\n\t\tfloat glowing_edges = smpl.r * 0.8;\t// kante oben\n\t\tfloat ant_top_left_right = smpl.b;\n\t\tfloat lightfake_msk = mix(smpl_paint.b, pack_look.x, pack_look.z);\n\t\tfloat lightbow = (smpl_paint.r * clamp(pack_look.y, 0., 1.));\n\t\tfloat outlines = smpl.g;\n\t\tfloat birth = smoothstep(0.01, 0.05, v_consumption_value);\n\n\t\t#ifdef IS_FACTORY\n\t\t\tfloat bump2 = smoothstep(0., v_consumption_value, bump);\n\t\t\tfloat center = smoothstep(0.,0.5, bump2) * smoothstep(1.,0.5, bump2);\n\t\t\toutlines += center * smoothstep(0.3, 1., smpl.g);  // add to outlines\n\t\t#endif\n\t\t\n\n\t// -- color mixin\n\tfloat comsk = outlines * lightfake_msk;\n\tcomsk *= mix(1.,2.,lightbow);\n\tvec3 co = mix(mixed_co, mixed_hl, lightbow) + glowing_edges;\n\t// -- alphamask\n\tfloat alphamsk = ant_top_left_right * pre_alpha;\n\talphamsk += glowing_edges;\n\talphamsk *= birth;\n\n\tvec4 shd = vec4(co * comsk, alphamsk);\n\n\tgl_FragColor = shd;\n\tgl_FragColor.a *= opacity;\n\n\t// checker\n\t//gl_FragColor = smpl_paint;\n}";
static const char*bc_program_15_vs="#version 100\n\nprecision highp float;\n\nattribute vec2 a_TextureCoordinate;\nattribute vec3 a_Position;\n\nuniform mat4 u_MVPMatrix;\nuniform float bar_pos,consumption_value,eco,comfort,sport,is_factory;\n\nvarying vec3 mixed_co;\nvarying vec2 uv;\nvarying mediump float edge;\n\n#define DEFAULT vec3(1.,1.,1.)\n#define ECO vec3(0.,.45,.9) // edrive = eco\n#define COMFORT vec3(.59,.68,.75)\n#define SPORT vec3(1.,0.29,0.)\n#define FACTORY vec3(1.,1.,1.)\n\nvoid main(void) {\n\n\tuv = a_TextureCoordinate;\n\n\t// -- color mixin\n\tmediump float is_default = 1.- clamp(eco + comfort + sport + is_factory, 0., 1.);\n\tmixed_co = (DEFAULT * is_default) + (ECO * eco) + (COMFORT * comfort) + ((SPORT + 0.1) * sport);\n\t\tmixed_co = mix(mixed_co, FACTORY, is_factory);\n\n\tvec3 p = a_Position;\n\t//\tmediump float little_step = step(1.1, bar_pos); //222 79\n\t//\tp.x += (clamp(bar_pos, 0., 1.) * 222.) + (little_step * (bar_pos - 1.) * 79.);\t\n\n\tgl_Position = u_MVPMatrix * vec4(p, 1.);\n\n\t// -- FS handovers\n\tedge = consumption_value;\n}";
static const char*bc_program_15_fs="#version 100\n\nprecision mediump float;\n\nuniform sampler2D tex0;\nuniform float opacity;\n\nvarying vec3 mixed_co;\nvarying vec2 uv;\nvarying float edge;\n\n//checker\n//uniform float tst;\n\nvoid main(void) {\n\n\tvec4 smpl = texture2D(tex0,uv);\n\tfloat smoothness = 0.15;\n\tfloat msk = smoothstep(edge + smoothness, edge, uv.y);\n\tfloat alphamask = smpl.b * msk * 0.2;\n\n\tvec4 shd = vec4(mixed_co, alphamask);\n\tgl_FragColor = shd;\t\n\tgl_FragColor.a *= opacity;\n}";
static const char*bc_program_16_vs="#version 100\n#define IS_FACTORY\nprecision highp float;\n\nattribute vec4 a_Color;\nattribute vec2 a_TextureCoordinate;\nattribute vec3 a_Position;\n\nuniform mat4 u_MVPMatrix;\nuniform float consumption_value,eco,comfort,sport,bar_pos,is_factory;\n\nvarying mediump vec2 varCoord,paintCoord;\nvarying mediump vec3 mixed_co,mixed_hl,pack_look;\nvarying mediump float pre_alpha,v_consumption_value,bump;\n\n\n#define DEFAULT vec3(1.,1.,1.) * 0.6\n#define ECO vec3(0.,.5, 1.) // edrive = eco\n#define COMFORT vec3(.57,.68,.7) * 0.8\n#define SPORT vec3(1.,0.29,0.)\n#define FACTORY vec3(1.,1.,1.)\n\n#define HL_DEFAULT vec3(.7,.7,.7) * 0.6\n#define HL_ECO vec3(.3,.6,0.8)\n#define HL_COMFORT vec3(.65,.69,.7) * 0.9\n#define HL_SPORT vec3(1.,0.5,0.2)\n#define HL_FACTORY vec3(1.,1.,1.)\n\n\nvoid main(void){\n\n\t// -- texture coordinates\n\tvarCoord = a_TextureCoordinate;\n\t\t// -- growth\n\t\tvarCoord.y += mix(0.965,0.007,consumption_value);\n\n\tpaintCoord = a_TextureCoordinate;\n\t\tpaintCoord.y -= smoothstep(-3.,10.,consumption_value);\n\n\t// -- mix color\n\tfloat is_default = 1. - clamp(eco + comfort + sport + is_factory, 0., 1.);\n\tmixed_co = (DEFAULT * is_default) + (ECO * eco) + (COMFORT * comfort) + ((SPORT + 0.1) * sport);\n\tmixed_hl = (HL_DEFAULT * is_default) + (HL_ECO * eco) + (HL_COMFORT * comfort) + (HL_SPORT * sport);\n\t//mixed_hl = mix(mixed_co, vec3(1.,1.,1.), 0.2);\n\n\t#ifdef IS_FACTORY\n\t\tmixed_co = mix(mixed_co, FACTORY, is_factory);\n\t\tmixed_hl = mix(mixed_co, HL_FACTORY, is_factory);\n\t#endif\n\t\t\n\n\t// -- bar pos\n\t//vec3 p = a_Position;\n\t//\tfloat little_step = step(1.1, bar_pos); //222 79\n\t//\tp.x += (clamp(bar_pos, 0., 1.) * 222.) + (little_step * (bar_pos - 1.) * 79.);\t\n\tgl_Position = u_MVPMatrix * vec4(a_Position, 1.);\n\n\n\t// -- FS handovers\n\tpre_alpha = 1.;\n\tpre_alpha *= a_Color.b; // antialiasing\n\t\n\tv_consumption_value = consumption_value;\n\tbump = a_TextureCoordinate.y;\n\n\n\t// -- pack em\n\tfloat fade = a_TextureCoordinate.t * mix(4.,1.,consumption_value); // top top bottom\n\tfade += 0.19;\n\tfloat lightbow_fade = (1.-a_TextureCoordinate.t) * 3. - mix(2.5, 1., consumption_value);  // bottom to top\n\tfloat lightfake_end = 1.-consumption_value;\n\tpack_look = vec3(fade, lightbow_fade, lightfake_end);\n}";
static const char*bc_program_16_fs="#version 100\n#define IS_FACTORY\nprecision mediump float;\n\nuniform sampler2D tex0,tex1;\nuniform float opacity;\nvarying mediump vec2 varCoord,paintCoord;\nvarying mediump vec3 mixed_co,mixed_hl,pack_look;\nvarying float pre_alpha,v_consumption_value,bump;\n\nvoid main(void){\n\n\n\t// -- samples\n\tvec4 smpl = texture2D(tex0, varCoord);\n\tvec4 smpl_paint = texture2D(tex1, paintCoord);\n\n\n\t\t// -- toolbox\n\t\tfloat glowing_edges = smpl.r * 0.8;\t// kante oben\n\t\tfloat ant_top_left_right = smpl.b;\n\t\tfloat lightfake_msk = mix(smpl_paint.b, pack_look.x, pack_look.z);\n\t\tfloat lightbow = (smpl_paint.r * clamp(pack_look.y, 0., 1.));\n\t\tfloat outlines = smpl.g;\n\t\tfloat birth = smoothstep(0.01, 0.05, v_consumption_value);\n\n\t\t#ifdef IS_FACTORY\n\t\t\tfloat bump2 = smoothstep(0., v_consumption_value, bump);\n\t\t\tfloat center = smoothstep(0.,0.5, bump2) * smoothstep(1.,0.5, bump2);\n\t\t\toutlines += center * smoothstep(0.3, 1., smpl.g);  // add to outlines\n\t\t#endif\n\t\t\n\n\t// -- color mixin\n\tfloat comsk = outlines * lightfake_msk;\n\tcomsk *= mix(1.,2.,lightbow);\n\tvec3 co = mix(mixed_co, mixed_hl, lightbow) + glowing_edges;\n\t// -- alphamask\n\tfloat alphamsk = ant_top_left_right * pre_alpha;\n\talphamsk += glowing_edges;\n\talphamsk *= birth;\n\n\tvec4 shd = vec4(co * comsk, alphamsk);\n\n\tgl_FragColor = shd;\n\tgl_FragColor.a *= opacity;\n\n\t// checker\n\t//gl_FragColor = smpl_paint;\n}";
static const char*bc_program_17_vs="#version 100\nprecision highp float;\nattribute vec2 a_TextureCoordinate;\nattribute vec3 a_Position;\nvarying vec2 uv;\nuniform mat4 u_MVPMatrix;\n\tuniform highp mat4 u_MMatrix;\n\tuniform highp vec4 u_ScrollAreaFadeParameters;\n\tuniform highp mat4 u_ScrollAreaInverseWorldTransformation;\n\tuniform highp float u_ScrollAreaDirection;\n\tvarying vec2 vFading;\n\tvec2 calcMask( vec2 posXZ ) {\n\t\tvec2 result = vec2(1.,1.);\n\t\tif (u_ScrollAreaDirection < 0.0) {\n\t\t\tresult.x = (posXZ.y - u_ScrollAreaFadeParameters.x) * u_ScrollAreaFadeParameters.y;\n\t\t\tresult.y = 1.0 - ((posXZ.y - u_ScrollAreaFadeParameters.z) * u_ScrollAreaFadeParameters.w);\n\t\t\t}\n\t\telse if (u_ScrollAreaDirection > 0.0) {\n\t\t\tresult.x = (posXZ.x - u_ScrollAreaFadeParameters.x) * u_ScrollAreaFadeParameters.y;\n\t\t\tresult.y = 1.0 - ((posXZ.x - u_ScrollAreaFadeParameters.z) * u_ScrollAreaFadeParameters.w);\n\t\t\t}\n\t\treturn result;\n\t\t}\nvoid main(void) {\n\tuv = a_TextureCoordinate;\n\tgl_Position = u_MVPMatrix * vec4(a_Position, 1.);\n\tvec4 pos = vec4(a_Position.xyz, 1.0);\n\t\tvec4 scrollAreaPos = u_ScrollAreaInverseWorldTransformation * u_MMatrix * pos;\n\t\tvFading = calcMask( scrollAreaPos.xz );\n\tgl_Position = u_MVPMatrix * pos;\n}";
static const char*bc_program_17_fs="#version 100\nprecision mediump float;\nuniform sampler2D tex0;\nuniform float u_opacity;\nuniform float u_ContainerActive;\nuniform vec3 u_color;\nvarying vec2 uv;\n\tvarying highp vec2 vFading;\nvoid main(void) {\n\tvec2 fading = clamp(vFading, vec2(0.0), vec2(1.0));\n\tfloat fade = fading.x * fading.y;\n\tvec4 smpl = texture2D (tex0, uv);\n\tfloat am = smpl.b;\n\tfloat cm = smpl.g;\n\tvec4 shd = vec4(cm * u_color, am);\n\tgl_FragColor = shd;\n\tgl_FragColor.a *= u_opacity;\n\tgl_FragColor.a *= u_ContainerActive;\n\tgl_FragColor.a *= fade;\n}";
