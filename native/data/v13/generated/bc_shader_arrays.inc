static const char*bc_program_10_vs="#version 100\nprecision highp float;\n\nattribute vec2 a_TextureCoordinate;\nattribute vec3 a_Position;\n\nuniform mat4 u_MVPMatrix;\nuniform float consumption_value,bar_pos,eco,comfort,sport,is_factory; // edrive = eco\n\nvarying vec3 mixed_co;\nvarying vec2 uvCoord;\nvarying mediump float size_adj,pre_alpha,v_is_factory;\n\n#define DEFAULT vec3(0.,0.,0.)\n#define ECO vec3(0.,.45,.9) \n#define COMFORT vec3(.59,.68,.75)\n#define SPORT vec3(1.,0.29,0.)\n#define FACTORY vec3(1.,1.,1.)\n\nvoid main(void) {\n\n\t// -- texture coordinates\t\n\tuvCoord = a_TextureCoordinate;\n\tuvCoord.y += mix(1.,0.02,consumption_value);\n\n\t\n\t// -- color mixin\n\tmediump float is_default = 1.- clamp(eco + comfort + sport + is_factory, 0., 1.);\n\tmixed_co = (DEFAULT * is_default) + (ECO * eco) + (COMFORT * comfort) + ((SPORT + 0.1) * sport);\n\tfloat satur = 0.4;\n\tmixed_co = mix(vec3(0.8,0.8,0.8), mixed_co, satur);\n\tmixed_co = mix(mixed_co, vec3(1.,1.,1.), is_factory);\n\n\tgl_Position = u_MVPMatrix * vec4(a_Position, 1.);\n\n\t// -- FS handovers\n\tsize_adj = mix(0.9, 0., consumption_value);\n\tpre_alpha = 0.2 * clamp(consumption_value + 0.2, 0.,1.);\n\tv_is_factory = is_factory;\n}";
static const char*bc_program_10_fs="#version 100\n\nprecision mediump float;\n\nuniform sampler2D tex0;\nuniform float opacity;\n\nvarying vec3 mixed_co;\nvarying vec2 uvCoord;\nvarying float size_adj,pre_alpha,v_is_factory;\n\nvoid main(void) {\n\n\t\t// -- prepare gradient for different sizes\n\t\tvec2 uv = uvCoord;\n\t\tuv.y = smoothstep(size_adj, 1., uvCoord.y);\n\n\tvec4 smpl = texture2D(tex0, uv);\n\tfloat alphamask = mix(smpl.g, smpl.b, v_is_factory) * pre_alpha;\n\n\tvec4 shd = vec4(mixed_co, alphamask);\n\n\tgl_FragColor = shd;\n\tgl_FragColor.a *= opacity;\t\n}";
static const char*bc_program_11_vs="#version 100\n\nprecision highp float;\n\nattribute vec2 a_TextureCoordinate;\nattribute vec3 a_Position;\n\nuniform mat4 u_MVPMatrix;\nuniform float eco,comfort,sport,bar_pos,is_factory;\n\nvarying mediump vec2 varCoord;\nvarying mediump vec3 mixed_co;\n\nconst vec3 DEFAULT = vec3(0.,0.,0.);\nconst vec3 ECO = vec3(0.,.45,.9);\nconst vec3 COMFORT = vec3(.59,.68,.70);\nconst vec3 SPORT = vec3(1.,0.29,0.);\nconst vec3 FACTORY = vec3(1.,1.,1.) * 0.6;\n\nvoid main(void) {\n\n\tvarCoord = a_TextureCoordinate;\n\n\n\t// -- mix color\n\tmediump float is_default = 1.-clamp(eco + comfort + sport + is_factory, 0., 1.);\n\tmixed_co = (DEFAULT * is_default) + (ECO * eco) + (COMFORT * comfort) + ((SPORT + 0.1) * sport);\n\t\tmixed_co = mix(mixed_co, FACTORY, is_factory);\t\n\n\t// -- bar update\n\tvec3 p = a_Position;\n\t\t//mediump float little_step = step(1.1,bar_pos); //222 79\n\t\t//p.x += (clamp(bar_pos, 0., 1.) * 222.) + (little_step * (bar_pos - 1.) * 79.);\t\n\tgl_Position = u_MVPMatrix * vec4(p, 1.);\n}";
