static unsigned bc_check(int mutate,int*verified,unsigned*visible){unsigned reads=0;*visible=0;for(unsigned i=0;i<bc_sprite_count;i++){BcSprite*p=&bc_sprites[i];bc_prepare_matrix(p);if(mutate)check_status(FN(CcMatrix,"_ZN6ramses10Appearance22setInputValueMatrix44fERKNS_12UniformInputEPKf")(p->app,&p->matrix,p->expectedMatrix),"BC metadata matrix");_Bool show=!cc_selected&&bc_page==p->page&&(p->fixtureMask&(1<<((semantic_active&&bc_page!=2)?0:bc_fixture)));if(semantic_active&&!strncmp(p->name,"bcTotalValue",12))show=0;if(mutate)check_status(FN(V3SetVisibility,"_ZN6ramses4Node13setVisibilityEb")(p->mesh,show),"BC visibility");*verified&=FN(V3GetVisibility,"_ZNK6ramses4Node13getVisibilityEv")(p->mesh)==show;reads++;*visible+=show;float after[16];check_status(FN(BcReadMatrix,"_ZNK6ramses10Appearance22getInputValueMatrix44fERKNS_12UniformInputEPf")(p->app,&p->matrix,after),"BC matrix readback");for(int k=0;k<16;k++)*verified&=fabsf(after[k]-p->expectedMatrix[k])<.000001f;reads++;check_status(FN(BcReadColour,"_ZNK6ramses10Appearance21getInputValueVector4fERKNS_12UniformInputERfS4_S4_S4_")(p->app,&p->colour,&after[0],&after[1],&after[2],&after[3]),"BC colour readback");for(int k=0;k<4;k++)*verified&=fabsf(after[k]-p->expectedColour[k])<.000001f;reads++;}return reads+bc_source_check(mutate,verified,visible);}
static unsigned apply_bc(int*verified){unsigned visible=0;return bc_check(1,verified,&visible);}
