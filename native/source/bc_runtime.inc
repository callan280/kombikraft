static double bc_monotonic(void){struct timespec t;if(clock_gettime(CLOCK_MONOTONIC,&t))exit(8);return (double)t.tv_sec+t.tv_nsec/1e9;}
static void bc_marquee_reset(void){bc_marquee_elapsed=0;bc_marquee_last=bc_monotonic();}
static double bc_marquee_offset(double elapsed,double overflow){if(overflow<=0)return 0;double travel=overflow/28.0,cycle=1.5+travel+1.0+travel,t=fmod(elapsed,cycle);if(t<1.5)return 0;t-=1.5;if(t<travel)return t*28;t-=travel;if(t<1)return overflow;t-=1;return fmax(0,overflow-t*28);}
