static void process_bc(void*scene){static unsigned long long last=0;FILE*f=fopen("/tmp/native-bc-v6-request","r");if(!f)return;unsigned long long id;int page,fixture;int n=fscanf(f,"%llu %d %d",&id,&page,&fixture);fclose(f);if(n!=3||id<=last)return;last=id;if(page<0||page>5||fixture<0||fixture>2||(fixture==2&&page!=2)){printf("NATIVE_BC_V6_REJECT id=%llu\n",id);return;}const char*status=cc_selected?"blocked-popup":!bc_available[page]?"source-graphics-unavailable":"applied";int apply=!strcmp(status,"applied");if(apply){if(bc_page!=page||bc_fixture!=fixture)bc_marquee_reset();bc_page=page;bc_fixture=fixture;}int verified=1;unsigned visible=0,reads=bc_check(apply,&verified,&visible);unsigned flush=apply?FN(SceneFlush,"_ZN6ramses5Scene5flushENS_15ESceneFlushModeEm")(scene,1,id+700):0;printf("NATIVE_BC_V6_ACK {\"id\":%llu,\"page\":\"%s\",\"fixture\":%d,\"status\":\"%s\",\"readbackVerified\":%s,\"readbacks\":%u,\"visibleMeshes\":%u,\"flushStatus\":%u,\"physicalBcBound\":false,\"originalControllerExecuted\":false}\n",id,bc_page_names[bc_page],bc_fixture,status,verified?"true":"false",reads,visible,flush);}

static void tick_bc_marquee(void*scene){static unsigned frame;static unsigned long updates;double now=bc_monotonic();if(!bc_marquee_last)bc_marquee_last=now;double delta=now-bc_marquee_last;bc_marquee_last=now;int active=bc_page==2&&bc_fixture>0&&!cc_selected;if(active&&delta>0)bc_marquee_elapsed+=delta;int changed=0;double offset=0,overflow=0;int verified=1;for(unsigned i=0;i<bc_sprite_count;i++){BcSprite*p=&bc_sprites[i];if(p->page!=bc_page||!(p->fixtureMask&(1<<((semantic_active&&bc_page!=2)?0:bc_fixture)))||p->marqueeOverflow<=0)continue;overflow=p->marqueeOverflow;offset=bc_marquee_offset(bc_marquee_elapsed,overflow);if(!active)continue;float previous=p->animatedMatrix[12];bc_prepare_matrix(p);if(fabsf(previous-p->animatedMatrix[12])<.000001f)continue;check_status(FN(CcMatrix,"_ZN6ramses10Appearance22setInputValueMatrix44fERKNS_12UniformInputEPKf")(p->app,&p->matrix,p->expectedMatrix),"Marquee matrix update");float after[16];check_status(FN(BcReadMatrix,"_ZNK6ramses10Appearance22getInputValueMatrix44fERKNS_12UniformInputEPf")(p->app,&p->matrix,after),"Marquee actual matrix readback");for(int k=0;k<16;k++)verified&=fabsf(after[k]-p->expectedMatrix[k])<.000001f;updates++;changed=1;}if(!verified){fputs("CUSTOM_NATIVE_FAILURE marquee matrix readback\n",stderr);exit(8);}if(changed)check_status(FN(SceneFlush,"_ZN6ramses5Scene5flushENS_15ESceneFlushModeEm")(scene,1,0),"Marquee flush");if(++frame%30==0)printf("NATIVE_BC_V7_MARQUEE {\"elapsedMs\":%.3f,\"offsetPx\":%.6f,\"overflowPx\":%.6f,\"paused\":%s,\"readbackVerified\":true,\"matrixUpdates\":%lu}\n",bc_marquee_elapsed*1000,offset,overflow,active?"false":"true",updates);}
